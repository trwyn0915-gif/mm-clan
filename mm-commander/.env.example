# Copy these values into your hosting provider's private environment settings.
# Never commit a real token or send it in chat.
RUBIKA_BOT_TOKEN=PASTE_YOUR_NEW_ROTATED_TOKEN_HERE
# Add your own Rubika sender ID after running /myid (comma-separated for multiple admins).
MM_OWNER_IDS=

# Local Ollama (no API key required).
MM_AI_BASE_URL=http://localhost:11434/v1
MM_AI_MODEL=qwen2.5:1.5b
MM_AI_API_KEY=

# Explicit allowlists. Add only group/chat IDs where the bot has been introduced.
# AI replies to ordinary text only in these chats.
MM_AI_CHAT_IDS=
# Message history is stored locally ONLY in these separately opted-in chats.
MM_MEMORY_CHAT_IDS=

POLL_SECONDS=5
MM_AI_COOLDOWN_SECONDS=15
LOG_LEVEL=INFO
